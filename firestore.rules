rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback for development & offline sync
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicit collections structure
    match /mess_complaints/{complaintId} {
      allow read, write: if true;
    }

    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    match /student_complaints/{complaintId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}

